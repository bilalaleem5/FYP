# Neon Postgres Database URL (leave blank or omit to use local SQLite vehiclewalay.db)
DATABASE_URL=sqlite:///./vehiclewalay.db

# Groq Cloud API Key (Get a free instant key at https://console.groq.com/keys)
# Powers Groq Llama 3.2 Multimodal Vision AI (car verification & face detection) + Llama 3.3 Assistant Chat
GROQ_API_KEY=your_groq_api_key_here
